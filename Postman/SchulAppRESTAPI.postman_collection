                  "const idKeys = ['test_lehrer_id','test_klasse_id','test_schueler_id','test_kurs_id','test_stundenplan_id','test_einstellung_id'];",
                  "const leftovers = idKeys.filter((key) => {",
                  "    const value = pm.collectionVariables.get(key);",
                  "    return value !== undefined && value !== null && String(value).trim() !== '';",
                  "});",
                  "if (leftovers.length > 0) {",
                  "    throw new Error('Sicherheitsstopp: Es existieren noch Test-IDs aus einem früheren oder unterbrochenen Lauf. Zuerst 01 / E - Aufräumen ausführen.');",
                  "}",
                  "const runId = Date.now().toString() + Math.floor(Math.random() * 10000).toString().padStart(4, '0');",
                  "pm.collectionVariables.set('run_id', runId);",
                  "pm.collectionVariables.set('test_run_active', 'true');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API antwortet mit HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Antwort ist eine JSON-Liste', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
